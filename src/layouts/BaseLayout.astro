---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteBase } from '../utils/base';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A small blog with backlinks between posts.' } = Astro.props;
const siteName = "Vadin's Blog";
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;
const base = siteBase(import.meta.env.BASE_URL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
