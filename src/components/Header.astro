---
import { siteBase } from '../utils/base';
const base = siteBase(import.meta.env.BASE_URL);
const path = Astro.url.pathname;

const links = [
  { href: `${base}`, label: 'Home' },
  { href: `${base}blog/`, label: 'Blog' },
  { href: `${base}about/`, label: 'About' },
];

function isCurrent(href: string) {
  if (href === base) return path === base || path === base.replace(/\/$/, '');
  return path.startsWith(href);
}
---

<header class="site-header">
  <div class="wrap wrap--wide site-header__row">
    <a class="wordmark" href={base}>vadin's <em>blog</em></a>
    <nav class="site-nav" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
