{
  "name": "vadin-blog",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:local": "astro dev --base /",
    "build": "astro build",
    "build:local": "astro build --base /",
    "preview": "astro preview",
    "preview:local": "astro preview --base /",
    "astro": "astro",
    "frontmatter": "node scripts/auto-frontmatter.mjs",
    "prebuild": "npm run frontmatter",
    "predev": "npm run frontmatter",
    "prebuild:local": "npm run frontmatter",
    "predev:local": "npm run frontmatter",
    "deploy": "gh-pages -d dist -b gh-pages"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.2.6",
    "unist-util-visit": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
