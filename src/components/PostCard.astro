---
import { siteBase } from '../utils/base';

interface Props {
  slug: string;
  title: string;
  description: string;
  call: string;
}

const { slug, title, description, call } = Astro.props;
const base = siteBase(import.meta.env.BASE_URL);
---

<a class="card" href={`${base}blog/${slug}/`} data-call={call}>
  <h3>{title}</h3>
  <p>{description}</p>
</a>
